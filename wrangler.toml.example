name = "md-page"
main = "src/index.ts"
compatibility_date = "2024-12-01"

routes = [
  { pattern = "your-domain.com/*", zone_name = "your-domain.com" }
]

[observability]
enabled = true

# Required: page content storage
[[kv_namespaces]]
binding = "PAGES"
id = "" # Run: npx wrangler kv namespace create PAGES

# Optional: event analytics (page publishes, views, rate-limit hits).
# Remove this block if you don't want analytics — the worker runs fine without it.
[[analytics_engine_datasets]]
binding = "ANALYTICS"
dataset = "md_page_events"

# Optional: serves the landing page demo video from R2.
# Remove if you don't need it — the landing page still works.
[[r2_buckets]]
binding = "ASSETS_BUCKET"
bucket_name = "" # Run: npx wrangler r2 bucket create md-page-assets

# Optional: worker-level rate limiting on anonymous publishes. The worker runs
# fine without these bindings (useful for local dev and tests).
# [[unsafe.bindings]]
# name = "PUBLISH_LIMITER"
# type = "ratelimit"
# namespace_id = "1001"
# simple = { limit = 30, period = 60 }   # per-IP

# [[unsafe.bindings]]
# name = "PUBLISH_GLOBAL_LIMITER"
# type = "ratelimit"
# namespace_id = "1002"
# simple = { limit = 500, period = 60 }  # shared global counter
